---
import { BLOC_NAMES, fmtDate, fmtInt, pollsterName, sponsorName, type Poll } from "../lib/data";
interface Props {
  polls: Poll[];
}
const { polls } = Astro.props;
---

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>תאריך ביצוע</th>
        <th>סוקר</th>
        <th>מזמין</th>
        <th class="num">משיבים</th>
        <th class="num">{BLOC_NAMES.coalition}</th>
        <th class="num">{BLOC_NAMES.opposition}</th>
        <th class="num">{BLOC_NAMES.arab}</th>
      </tr>
    </thead>
    <tbody>
      {
        polls.map((p) => (
          <tr>
            <td>
              <a href={`/polls/${p.key}`}>{fmtDate(p.field_date)}</a>
            </td>
            <td>{pollsterName(p.pollster, p.pollster_raw)}</td>
            <td>{sponsorName(p.sponsor, p.sponsor_raw)}</td>
            <td class="num">{fmtInt(p.meta.respondents)}</td>
            <td class="num">{p.blocs?.coalition ?? "—"}</td>
            <td class="num">{p.blocs?.opposition ?? "—"}</td>
            <td class="num">{p.blocs?.arab ?? "—"}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
