---
// G2 — the 120 seats in one strip, with the majority line in the middle. The strip itself is
// decorative; the list under it carries the same numbers as text.
import Num from "../data/Num.astro";
import type { StripSegment } from "../../lib/selectors";

interface Props {
  segments: StripSegment[];
  majority?: number;
  total?: number;
  /** Whose seats these are, for the caption ("לפי הממוצע" by default). */
  source?: string;
  /** The list of numbers under the strip; off when the caller shows them its own way. */
  legend?: boolean;
}
const { segments, majority = 61, total = 120, source = "לפי הממוצע", legend = true } = Astro.props;
const pct = (v: number) => `${((100 * v) / total).toFixed(3)}%`;
---

<figure class="seat-strip">
  <figcaption class="strip-head">{total} המנדטים {source} · הקו: {majority} מנדטים הם רוב</figcaption>
  <div class="strip-scale" aria-hidden="true"><span style={`inset-inline-start: ${pct(majority)}`}>{majority}</span></div>
  <div class="strip" aria-hidden="true">
    {
      segments.map((s) => (
        <span class="strip-seg" style={`width: ${pct(s.seats)}; background: var(--bloc-${s.bloc})`}>
          {s.seats / total >= 0.12 && <span class="strip-num">{Math.round(s.seats)}</span>}
        </span>
      ))
    }
    <span class="strip-line" style={`inset-inline-start: ${pct(majority)}`}></span>
  </div>
  {
    legend && (
      <ul class="strip-legend">
        {segments.map((s) => (
          <li>
            <i class="swatch" style={`background: var(--bloc-${s.bloc})`} />
            {s.name} <strong><Num value={s.seats} /></strong>
          </li>
        ))}
      </ul>
    )
  }
</figure>
