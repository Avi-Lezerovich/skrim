---
// G3 — seats per party, one row each: name (with the spread under it), a light bar from the
// start edge to the average, a dark whisker for the spread, the dashed threshold, and the
// seats. HTML, not SVG: the list is its own text alternative.
import { u } from "../../lib/url";
import Num from "../data/Num.astro";
import { THRESHOLD_SEATS, type PartyRow } from "../../lib/selectors";

interface Props {
  rows: PartyRow[];
  /** Scale maximum in seats; defaults to the largest upper spread. */
  max?: number;
  threshold?: number;
}
const { rows, threshold = THRESHOLD_SEATS } = Astro.props;
const max = Astro.props.max ?? Math.max(...rows.map((r) => r.hi)) * 1.04;
const pct = (v: number) => `${Math.max(0, Math.min(100, (100 * v) / max)).toFixed(2)}%`;
---

<ol class="seat-bars" style={`--threshold: ${pct(threshold)}`}>
  {
    rows.map((r) => (
      <li class="seat-bar">
        <a class="seat-bar-name" href={u(`/trends#party-${r.id}`)}>
          <span class="seat-bar-label">
            <i class="swatch" style={`background: ${r.color}`} />
            <span>{r.name}</span>
          </span>
          <span class="seat-bar-range-text"><span class="sr-only">פיזור בין הסוקרים </span><Num kind="range" lo={r.lo} hi={r.hi} /></span>
        </a>
        <span class="seat-bar-track" aria-hidden="true">
          <span class="seat-bar-fill" style={`width: ${pct(r.mean)}`} />
          <span class="seat-bar-range" style={`inset-inline-start: ${pct(r.lo)}; width: calc(${pct(r.hi)} - ${pct(r.lo)})`} />
        </span>
        <strong class="seat-bar-val"><Num value={r.mean} /></strong>
      </li>
    ))
  }
</ol>
