---
// Election night, at the top of the home page: each channel's exit poll as a card (blocs, parties, change since the
// channel's last filed poll, distances), tabs to switch channel, and every exit poll side by
// side. Once results.csv is filled each poll also gets an accuracy score. Without JS every
// card is shown, one after another.
import { u } from "../../lib/url";
import Num from "../data/Num.astro";
import SeatStrip from "./SeatStrip.astro";
import { exitPolls, fmtDate, pollsterName } from "../../lib/data";
import { exitCards, exitTable, seatDistance } from "../../lib/selectors";

const cards = exitCards();
const table = exitTable();
const results = exitPolls.results;
const time = (iso: string | null) => iso?.slice(11, 16) ?? null;
const scale = Math.max(30, ...cards.flatMap((c) => c.bars.flatMap((b) => [b.seats, b.before ?? 0])));
const pct = (v: number) => `${((100 * v) / scale).toFixed(2)}%`;
/** Direction of a change, for its colour: up, down or none. */
const dir = (d: number) => (d > 0 ? "up" : d < 0 ? "down" : "same");
const digits = (v: number) => (Number.isInteger(v) ? 0 : 1);
const pollsCol = table.columns.find((c) => c.id === "polls")!;
const best = results ? Math.min(...cards.map((c) => c.accuracy!)) : null;
const sources = [...new Set(cards.flatMap((c) => [...(c.first ? [c.first.source_url] : []), c.latest.source_url]))];
/** What all the exit polls share: each bloc's range, and the largest party in each. */
const ranges = cards[0].blocs.map((b, i) => {
  const v = cards.map((c) => c.blocs[i].seats);
  return { ...b, lo: Math.min(...v), hi: Math.max(...v) };
});
const leaders = cards.map((c) => c.bars[0]);
const sameLeader = leaders.every((l) => l.id === leaders[0].id) && cards.every((c) => c.bars[0].seats > c.bars[1].seats);
const leaderLo = Math.min(...leaders.map((l) => l.seats));
const leaderHi = Math.max(...leaders.map((l) => l.seats));
/** Channels by method, for the headline: who asked voters at polling stations, who ran a survey. */
const byMethod = (k: string) => cards.filter((c) => c.method.kind === k);
const station = byMethod("station");
const survey = byMethod("survey");
const unknown = byMethod("unknown");
const surveySource = survey[0]?.method.source_url ?? null;
/** "א, ב וג"; the conjunction takes a hyphen before a Latin name ("ו-i24NEWS"). */
const names = (cs: typeof cards) =>
  cs.map((c) => c.name).join(", ").replace(/, ([^,]*)$/, (_, last: string) => (/^[A-Za-z0-9]/.test(last) ? ` ו-${last}` : ` ו${last}`));
/** What to call a channel's numbers: an exit poll only when it asked voters at polling stations. */
const noun = (c: (typeof cards)[number]) => (c.method.kind === "survey" ? "סקר" : "מדגם");
/** A channel's statistical flag, and the innocent explanation shown beside it wherever it appears. */
const outlierLine = (c: (typeof cards)[number]) => `⚑ דגל סטטיסטי: ${noun(c)} ${c.name} חורג מכל שאר הערוצים`;
const OUTLIER_WHY = "הסבר אפשרי: שיטת דגימה, שקלול או מועד שונים.";
const METHOD_LABEL = { station: "מדגם בקלפיות", survey: "סקר, לא מדגם בקלפיות", unknown: "השיטה לא פורסמה" } as const;
const SHORT_LABEL = { station: "מדגם בקלפיות", survey: "סקר, לא מדגם", unknown: "שיטה לא פורסמה" } as const;
const TH_LABEL = { station: "קלפיות", survey: "סקר", unknown: "שיטה לא ידועה" } as const;
const methodOf = (id: string) => cards.find((c) => c.id === id)?.method.kind;
/** Do all the station exit polls agree on every bloc? Then the headline says so. */
const stationAgree =
  station.length > 1 && station[0].blocs.every((b, i) => station.every((c) => c.blocs[i].seats === b.seats));
const host = (url: string) => new URL(url).hostname.replace(/^www\./, "");
/** Shade an exit-poll cell 2+ seats from the average of the polls (rounded to whole seats). */
const gap = (seats: number, avg: number) => {
  const d = seats - Math.round(avg);
  return Math.abs(d) < 2 ? undefined : `${d > 0 ? "up" : "down"}${Math.abs(d) >= 4 ? 4 : 2}`;
};
---

<section class="exit-polls" aria-labelledby="exit-h">
  <header class="page-head">
    <h1 id="exit-h">הערוצים בליל הבחירות</h1>
    <p class="exit-summary">
      {ranges.map((r) => (
        <span><i class="swatch" style={`background: var(--bloc-${r.bloc})`} />{r.name} <strong>{r.lo === r.hi ? r.lo : <Num kind="range" lo={r.lo} hi={r.hi} />}</strong></span>
      ))}
    </p>
    <p class="page-note exit-summary-note">
      הטווח בין כל {cards.length} הערוצים{ranges.every((r) => r.hi < 61) && <>; אף גוש לא מגיע ל-61 באף ערוץ</>}.
      {sameLeader && <> {leaders[0].name} המפלגה הגדולה אצל כל הערוצים (<Num kind="range" lo={leaderLo} hi={leaderHi} />).</>}
    </p>
    {
      survey.length > 0 && (
        <div class="exit-method-alert">
          <p class="exit-method-alert-title">
            ⚑ <a href={`#exit-${survey[0].id}`}>{names(survey)}</a> לא ערכו מדגם בקלפיות אלא סקר
          </p>
          <p>
            לפי הארץ, {names(station)} שאלו מצביעים ביציאה מקלפיות שנבחרו לייצג את כל הקלפיות בארץ, ואילו {names(survey)}{" "}
            ערכו סקר גדול בהרבה של משיבים. מדגם גדול מדויק יותר רק אם הוא מייצג.
            {unknown.length > 0 && <> שיטת {names(unknown)} לא פורסמה במקורות שמצאנו.</>}
            {surveySource && <> <a href={surveySource} rel="noopener">המקור: הארץ ↗</a></>}
          </p>
          {stationAgree && (
            <p class="exit-method-agree">
              מדגמי הקלפיות של {names(station)} זהים בגושים: {station[0].blocs.map((b) => `${b.name} ${b.seats}`).join(" · ")}.
            </p>
          )}
        </div>
      )
    }
    {
      cards.filter((c) => c.outliers.length).map((c) => (
        <p class="exit-outlier-line">
          <a href={`#exit-${c.id}`} data-tab={`exit-tab-${c.id}`}>{outlierLine(c)}</a>
          {" "}({c.outliers.map((o) => `${o.name} ${o.seats}`).join(", ")}). {OUTLIER_WHY}
        </p>
      ))
    }
    <details class="page-note window-note">
      <summary>המספרים פורסמו עם סגירת הקלפיות; הם אינם תוצאה</summary>
      <p>
        הערוצים פרסמו את המספרים ב-27.10.2026 בשעה 22:00. מדגם הוא סקר של יוצאים מהקלפי. לכל
        ערוץ: השינוי מהסקר האחרון שלו לפני הבחירות, ועד כמה המספרים שלו רחוקים מהסקר הזה ומממוצע הסקרים.{" "}
        {
          results ? (
            <>ציון הדיוק משווה את המספרים של כל ערוץ ל{results.status === "final" ? "תוצאות האמת" : "תוצאות החלקיות"} של ועדת הבחירות.</>
          ) : (
            <>כשוועדת הבחירות תפרסם את תוצאות האמת, כל ערוץ יקבל ציון דיוק.</>
          )
        }
      </p>
    </details>
  </header>

  {/* The tabs double as an overview: each channel's blocs at a glance, the 61 line in the middle. */}
  <div class="exit-tabs" role="tablist" aria-label="בחירת ערוץ">
    {
      cards.map((c, i) => (
        <button type="button" role="tab" class:list={[c.outliers.length > 0 && "exit-tab-outlier"]} id={`exit-tab-${c.id}`} aria-controls={`exit-${c.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
          <span class="exit-tab-name">
            {c.name}
            <span class="exit-tab-lead">
              {c.bars[0].name} {c.bars[0].seats}{c.first && <> · עודכן</>}
            </span>
            <span class={`exit-method exit-method-${c.method.kind}`}>{SHORT_LABEL[c.method.kind]}</span>
            {c.outliers.length > 0 && <span class="exit-tab-flag">⚑ חריג מכל השאר; אולי שיטה שונה</span>}
          </span>
          <span class="exit-mini" aria-hidden="true">
            {c.blocs.map((b) => (
              <span class="exit-mini-seg" style={`width: ${((100 * b.seats) / 120).toFixed(3)}%; background: var(--bloc-${b.bloc})`}>{b.seats}</span>
            ))}
            <span class="exit-mini-line" style={`inset-inline-start: ${((100 * 61) / 120).toFixed(3)}%`} />
          </span>
          <span class="sr-only">{c.blocs.map((b) => `${b.name} ${b.seats}`).join(", ")}</span>
        </button>
      ))
    }
  </div>

  {
    cards.map((c) => (
      <article class="card exit-card" id={`exit-${c.id}`} role="tabpanel" aria-labelledby={`exit-tab-${c.id}`}>
        <header class="exit-card-head">
          <h2>
            {noun(c)} {c.name}
            {c.method.kind === "survey" && <span class="exit-h-note"> (לא מדגם בקלפיות)</span>}
          </h2>
          <p class="exit-meta">
            {c.first ? <>מדגם מעודכן{time(c.latest.published_at) && <>, {time(c.latest.published_at)}</>} (הראשון ב-{time(c.first.published_at)})</> : <>פורסם ב-{time(c.latest.published_at)}</>}
            {c.latest.pollster && <> · {c.latest.pollster}</>}
            {" · "}<a href={c.latest.source_url} rel="noopener">מקור: {host(c.latest.source_url)} ↗</a>
          </p>
        </header>

        {c.method.kind === "survey" ? (
          <div class="exit-outlier exit-survey" role="note">
            <p class="exit-outlier-title">⚑ {c.name} לא ערך מדגם בקלפיות: זה סקר</p>
            <p class="exit-outlier-why">
              לפי הארץ, {names(station)} שאלו מצביעים ביציאה מקלפיות נבחרות, ואילו {names(survey)} ערכו סקר גדול של משיבים.
              {c.method.source_url && <> <a href={c.method.source_url} rel="noopener">המקור: הארץ ↗</a></>}
            </p>
          </div>
        ) : (
          <p class="exit-method-line">
            <span class={`exit-method exit-method-${c.method.kind}`}>{METHOD_LABEL[c.method.kind]}</span>
            {c.method.kind === "station" && (
              <>
                {" "}מצביעים נשאלו ביציאה מקלפיות נבחרות
                {c.method.source_url && <> (<a href={c.method.source_url} rel="noopener">הארץ ↗</a>)</>}.
              </>
            )}
            {c.method.kind === "unknown" && <> לא מצאנו פרסום על אופן איסוף המספרים.</>}
          </p>
        )}

        {c.outliers.length > 0 && (
          <div class="exit-outlier" role="note">
            <p class="exit-outlier-title">{outlierLine(c)}</p>
            <ul>
              {c.outliers.map((o) => (
                <li>
                  {o.name}: <strong><Num value={o.seats} /></strong> מנדטים, לעומת <Num kind="range" lo={o.lo} hi={o.hi} /> אצל כל שאר הערוצים
                </li>
              ))}
            </ul>
            <p class="exit-outlier-why">{OUTLIER_WHY} המספרים כפי שפורסמו; ציון הדיוק מול התוצאות יראה מי היה קרוב יותר.</p>
          </div>
        )}

        <div class="exit-card-body">
          <div class="exit-blocs-box">
            <SeatStrip segments={c.blocs} source={`לפי ${noun(c)} ${c.name}`} legend={false} />
            <table class="exit-bloc-diff">
              <caption class="sr-only">הגושים ב{noun(c)} {c.name} ובסקר האחרון של הערוץ לפני הבחירות</caption>
              <thead>
                <tr>
                  <th scope="col">גוש</th>
                  <th scope="col" class="num">{noun(c)}</th>
                  {c.lastBlocs && <th scope="col" class="num">סקר אחרון</th>}
                  {c.lastBlocs && <th scope="col" class="num">הפרש</th>}
                </tr>
              </thead>
              <tbody>
                {c.blocs.map((b) => (
                  <tr>
                    <th scope="row"><span class="party-cell"><i class="swatch" style={`background: var(--bloc-${b.bloc})`} />{b.name}</span></th>
                    <td class="num"><strong><Num value={b.seats} /></strong></td>
                    {c.lastBlocs && <td class="num"><Num value={c.lastBlocs[b.bloc] ?? 0} /></td>}
                    {c.lastBlocs && (
                      <td class="num">
                        <span class={`exit-diff ${dir(b.seats - (c.lastBlocs[b.bloc] ?? 0))}`}>
                          <Num kind="signed" value={b.seats - (c.lastBlocs[b.bloc] ?? 0)} digits={0} />
                        </span>
                      </td>
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="exit-parties">
            <p class="exit-legend">
              <span><i class="exit-lg-fill" aria-hidden="true" />{noun(c)} {c.name} ביום הבחירות</span>
              {c.lastPoll && (
                <span>
                  <i class="exit-lg-ghost" aria-hidden="true" />
                  הסקר האחרון של {c.name}: <a href={u(`/polls/${c.lastPoll.key}`)}>{fmtDate(c.lastPoll.field_date)}</a>, {pollsterName(c.lastPoll.pollster, c.lastPoll.pollster_raw)}
                </span>
              )}
            </p>
            <div class="exit-cols" aria-hidden="true">
              <span>מפלגה</span><span /><span>{noun(c)}</span>{c.lastPoll && <><span>סקר</span><span>הפרש</span></>}
            </div>
            <ol class="exit-bars" aria-label={`המנדטים לכל מפלגה ב${noun(c)} ${c.name} ובסקר האחרון של הערוץ`}>
              {c.bars.map((b) => (
                <li class:list={[b.seats === 0 && "exit-out"]}>
                  <span class="exit-party">
                    <i class="swatch" style={`background: ${b.color}`} />
                    {b.name}
                  </span>
                  <span class="exit-track" aria-hidden="true">
                    {b.before != null && <span class="exit-ghost" style={`width: ${pct(b.before)}`} />}
                    <span class="exit-fill" style={`width: ${pct(b.seats)}; background: ${b.color}`} />
                  </span>
                  <strong class="exit-seats"><span class="sr-only">ב{noun(c)} </span><Num value={b.seats} /></strong>
                  {b.before != null && (
                    <>
                      <span class="exit-before"><span class="sr-only">בסקר האחרון </span><Num value={b.before} /></span>
                      <span class={`exit-diff ${dir(b.seats - b.before)}`}>
                        <span class="sr-only">הפרש </span><Num kind="signed" value={b.seats - b.before} digits={0} />
                      </span>
                    </>
                  )}
                </li>
              ))}
            </ol>
            {c.bars.some((b) => b.seats === 0) && <p class="exit-key">0 ב{noun(c)}: הרשימה לא עוברת את אחוז החסימה לפי ה{noun(c)}.</p>}
          </div>

          <dl class="exit-scores">
            <div class="exit-score-main">
              <dt>המרחק בין ה{noun(c)} לסקר האחרון של הערוץ</dt>
              <dd>
                {c.vsLastPoll == null ? <Num value={null} missing="אין לערוץ סקר במאגר" /> : <><Num value={c.vsLastPoll} digits={digits(c.vsLastPoll)} /> מנדטים זזו</>}
              </dd>
            </div>
            <div>
              <dt>המרחק מממוצע הסקרים</dt>
              <dd><Num value={c.vsAverage} digits={1} /> מנדטים</dd>
            </div>
            <div class="exit-accuracy">
              <dt>ציון דיוק מול התוצאות</dt>
              <dd>
                {c.accuracy == null ? (
                  <span class="muted">אחרי פרסום התוצאות</span>
                ) : (
                  <>
                    <Num value={c.accuracy} digits={digits(c.accuracy)} /> מנדטים
                    {c.accuracy === best && <span class="exit-best">המדויק ביותר</span>}
                  </>
                )}
              </dd>
            </div>
          </dl>
        </div>
        {c.latest.note && <p class="exit-note">{c.latest.note}</p>}
      </article>
    ))
  }

  <div class="exit-compare">
    <h2>כל הערוצים זה לצד זה</h2>
    <div class="table-wrap" tabindex="0" role="region" aria-label="טבלת כל הערוצים">
      <table class="exit-table">
        <caption class="sr-only">
          המנדטים לכל מפלגה אצל כל ערוץ (הגרסה האחרונה), ממוצע הערוצים וממוצע הסקרים מ-{fmtDate(table.avgDate)}
        </caption>
        <thead>
          <tr>
            <th scope="col">מפלגה</th>
            {table.columns.map((col) => (
              <th scope="col" class:list={["num", col.kind !== "exit" && "exit-col-ref"]}>
                {col.name}
                {cards.find((c) => c.id === col.id)?.outliers.length ? <><span class="exit-th-flag" aria-hidden="true"> ⚑</span><span class="sr-only">, דגל סטטיסטי</span></> : null}
                {methodOf(col.id) && <span class={`exit-th-method exit-method-${methodOf(col.id)}`}>{TH_LABEL[methodOf(col.id)!]}</span>}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {
            table.rows.map((r) => (
              <tr>
                <th scope="row"><span class="party-cell"><i class="swatch" style={`background: ${r.color}`} />{r.name}</span></th>
                {table.columns.map((col) => (
                  <td class:list={["num", col.kind !== "exit" && "exit-col-ref"]} data-gap={col.kind === "exit" ? gap(col.seats[r.id] ?? 0, pollsCol.seats[r.id] ?? 0) : undefined}>
                    <Num value={col.seats[r.id] ?? 0} digits={col.kind === "average" ? 1 : 0} />
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
        <tbody class="exit-blocs">
          {
            table.blocRows.map((b) => (
              <tr>
                <th scope="row"><span class="party-cell"><i class="swatch" style={`background: var(--bloc-${b.bloc})`} />{b.name}</span></th>
                {b.values.map((v, i) => (
                  <td class:list={["num", table.columns[i].kind !== "exit" && "exit-col-ref"]}>
                    <Num value={v} digits={table.columns[i].kind === "average" ? 1 : 0} />
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
        <tfoot>
          <tr>
            <th scope="row">מרחק מממוצע הסקרים</th>
            {table.columns.map((col) => (
              <td class:list={["num", col.kind !== "exit" && "exit-col-ref"]}>
                <Num value={seatDistance(col.seats, pollsCol.seats)} digits={1} />
              </td>
            ))}
          </tr>
          <tr class="exit-accuracy-row">
            <th scope="row">ציון דיוק מול התוצאות</th>
            {!results && <td colspan={table.columns.length} class="exit-pending">יחושב כשוועדת הבחירות תפרסם את תוצאות האמת</td>}
            {results && table.columns.map((col) => (
              <td class:list={["num", col.kind !== "exit" && "exit-col-ref", col.kind === "exit" && col.distance === best && "exit-best-cell"]}>
                <Num value={col.kind === "results" ? null : col.distance} digits={1} missing={col.kind === "results" ? "—" : "אחרי פרסום התוצאות"} />
              </td>
            ))}
          </tr>
        </tfoot>
      </table>
    </div>
    <p class="exit-key exit-heat-key">
      <span><i data-gap="up2" /> 2–3 מנדטים מעל ממוצע הסקרים</span>
      <span><i data-gap="up4" /> 4 ומעלה מעל</span>
      <span><i data-gap="down2" /> 2–3 מתחת</span>
      <span><i data-gap="down4" /> 4 ומעלה מתחת</span>
      {cards.some((c) => c.outliers.length) && <span>⚑ דגל סטטיסטי: חורג מכל שאר הערוצים. {OUTLIER_WHY}</span>}
    </p>
    <p class="exit-key">
      המרחק והציון: כמה מנדטים צריכים לעבור בין מפלגות כדי שהמספרים של הערוץ יהיו זהים להשוואה; 0 הוא זהות מלאה,
      והנמוך יותר מדויק יותר. ממוצע הסקרים הוא הממוצע האחרון במאגר, מ-{fmtDate(table.avgDate)}.
      המקורות (המספרים של ליל הבחירות אינם מדווחים לוועדת הבחירות):{" "}
      {sources.map((s, i) => <>{i > 0 && " · "}<a href={s} rel="noopener">{host(s)}</a></>)}
    </p>
  </div>
</section>

<script>
  // Tabs: one channel at a time. Without JS the overview still shows and every card is listed.
  const list = document.querySelector<HTMLElement>(".exit-tabs");
  if (list) {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute("aria-controls")!)!.hidden = !on;
      }
      if (focus) tab.focus();
    };
    select(tabs[0]);
    // A link to a card (the outlier line, or #exit-ch14 in the address) opens its tab.
    const fromHash = () => {
      const tab = tabs.find((t) => `#${t.getAttribute("aria-controls")}` === location.hash);
      if (tab) select(tab);
    };
    fromHash();
    addEventListener("hashchange", fromHash);
    list.addEventListener("click", (e) => {
      const tab = (e.target as HTMLElement).closest<HTMLButtonElement>("[role=tab]");
      if (tab) select(tab);
    });
    list.addEventListener("keydown", (e) => {
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      // RTL: the next tab is to the left.
      const step = { ArrowLeft: 1, ArrowRight: -1, Home: -i, End: tabs.length - 1 - i }[e.key];
      if (step == null) return;
      e.preventDefault();
      select(tabs[(i + step + tabs.length) % tabs.length], true);
    });
  }
</script>
