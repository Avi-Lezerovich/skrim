---
// Election night, at the top of the home page: each channel's exit poll as a card (blocs, parties, change since the
// channel's last filed poll, distances), tabs to switch channel, and every exit poll side by
// side. Once results.csv is filled each poll also gets an accuracy score. Without JS every
// card is shown, one after another.
import { u } from "../../lib/url";
import Num from "../data/Num.astro";
import SeatStrip from "./SeatStrip.astro";
import { exitPolls, fmtDate } from "../../lib/data";
import { exitCards, exitTable, seatDistance } from "../../lib/selectors";

const cards = exitCards();
const table = exitTable();
const results = exitPolls.results;
const time = (iso: string | null) => iso?.slice(11, 16) ?? null;
const scale = Math.max(30, ...cards.flatMap((c) => c.bars.map((b) => b.seats)));
const pct = (v: number) => `${((100 * v) / scale).toFixed(2)}%`;
const digits = (v: number) => (Number.isInteger(v) ? 0 : 1);
const pollsCol = table.columns.find((c) => c.id === "polls")!;
const best = results ? Math.min(...cards.map((c) => c.accuracy!)) : null;
const sources = [...new Set(cards.flatMap((c) => [...(c.first ? [c.first.source_url] : []), c.latest.source_url]))];
/** What all the exit polls share: each bloc's range, and the largest party in each. */
const ranges = cards[0].blocs.map((b, i) => {
  const v = cards.map((c) => c.blocs[i].seats);
  return { ...b, lo: Math.min(...v), hi: Math.max(...v) };
});
const leaders = cards.map((c) => c.bars[0]);
const sameLeader = leaders.every((l) => l.id === leaders[0].id) && cards.every((c) => c.bars[0].seats > c.bars[1].seats);
const leaderLo = Math.min(...leaders.map((l) => l.seats));
const leaderHi = Math.max(...leaders.map((l) => l.seats));
const host = (url: string) => new URL(url).hostname.replace(/^www\./, "");
/** Shade an exit-poll cell 2+ seats from the average of the polls (rounded to whole seats). */
const gap = (seats: number, avg: number) => {
  const d = seats - Math.round(avg);
  return Math.abs(d) < 2 ? undefined : `${d > 0 ? "up" : "down"}${Math.abs(d) >= 4 ? 4 : 2}`;
};
---

<section class="exit-polls" aria-labelledby="exit-h">
  <header class="page-head">
    <h1 id="exit-h">מדגמי הערוצים</h1>
    <p class="exit-summary">
      {ranges.map((r) => (
        <span><i class="swatch" style={`background: var(--bloc-${r.bloc})`} />{r.name} <strong>{r.lo === r.hi ? r.lo : <Num kind="range" lo={r.lo} hi={r.hi} />}</strong></span>
      ))}
    </p>
    <p class="page-note exit-summary-note">
      הטווח בין {cards.length} המדגמים{ranges.every((r) => r.hi < 61) && <>; אף גוש לא מגיע ל-61 באף מדגם</>}.
      {sameLeader && <> {leaders[0].name} המפלגה הגדולה בכל המדגמים (<Num kind="range" lo={leaderLo} hi={leaderHi} />).</>}
    </p>
    <details class="page-note window-note">
      <summary>המדגמים פורסמו עם סגירת הקלפיות; מדגם אינו תוצאה</summary>
      <p>
        המדגמים פורסמו ב-27.10.2026 בשעה 22:00. מדגם הוא סקר של יוצאים מהקלפי, לא תוצאה. לכל ערוץ: השינוי מהסקר
        האחרון שלו לפני הבחירות, ועד כמה המדגם רחוק מהסקר הזה ומממוצע הסקרים.{" "}
        {
          results ? (
            <>ציון הדיוק משווה כל מדגם ל{results.status === "final" ? "תוצאות האמת" : "תוצאות החלקיות"} של ועדת הבחירות.</>
          ) : (
            <>כשוועדת הבחירות תפרסם את תוצאות האמת, כל מדגם יקבל ציון דיוק.</>
          )
        }
      </p>
    </details>
  </header>

  {/* The tabs double as an overview: each channel's blocs at a glance, the 61 line in the middle. */}
  <div class="exit-tabs" role="tablist" aria-label="בחירת ערוץ">
    {
      cards.map((c, i) => (
        <button type="button" role="tab" id={`exit-tab-${c.id}`} aria-controls={`exit-${c.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
          <span class="exit-tab-name">
            {c.name}
            <span class="exit-tab-lead">
              {c.bars[0].name} {c.bars[0].seats}{c.first && <> · עודכן</>}
            </span>
          </span>
          <span class="exit-mini" aria-hidden="true">
            {c.blocs.map((b) => (
              <span class="exit-mini-seg" style={`width: ${((100 * b.seats) / 120).toFixed(3)}%; background: var(--bloc-${b.bloc})`}>{b.seats}</span>
            ))}
            <span class="exit-mini-line" style={`inset-inline-start: ${((100 * 61) / 120).toFixed(3)}%`} />
          </span>
          <span class="sr-only">{c.blocs.map((b) => `${b.name} ${b.seats}`).join(", ")}</span>
        </button>
      ))
    }
  </div>

  {
    cards.map((c) => (
      <article class="card exit-card" id={`exit-${c.id}`} role="tabpanel" aria-labelledby={`exit-tab-${c.id}`}>
        <header class="exit-card-head">
          <h2>מדגם {c.name}</h2>
          <p class="exit-meta">
            {c.first ? <>מדגם מעודכן{time(c.latest.published_at) && <>, {time(c.latest.published_at)}</>} (הראשון ב-{time(c.first.published_at)})</> : <>פורסם ב-{time(c.latest.published_at)}</>}
            {c.latest.pollster && <> · {c.latest.pollster}</>}
            {" · "}<a href={c.latest.source_url} rel="noopener">מקור: {host(c.latest.source_url)} ↗</a>
          </p>
        </header>

        <SeatStrip segments={c.blocs} source={`לפי מדגם ${c.name}`} />

        <ol class="exit-bars" aria-label={`המנדטים לכל מפלגה במדגם ${c.name}`}>
          {c.bars.map((b) => (
            <li>
              <span class="exit-party">
                <i class="swatch" style={`background: ${b.color}`} />
                {b.name}
              </span>
              <span class="exit-track" aria-hidden="true">
                <span class="exit-fill" style={`width: ${pct(b.seats)}; background: ${b.color}`} />
                <span class="exit-avg" style={`inset-inline-start: ${pct(b.avg)}`} />
              </span>
              <strong class="exit-seats"><Num value={b.seats} /></strong>
              <span class:list={["exit-delta", b.before != null && b.seats !== b.before && "changed"]}>
                {b.before != null && (
                  <>
                    <span class="sr-only">שינוי מהסקר האחרון: </span>
                    <Num kind="signed" value={b.seats - b.before} digits={0} />
                  </>
                )}
              </span>
            </li>
          ))}
        </ol>
        {c.lastPoll && (
          <p class="exit-key">
            <span class="exit-avg-key" aria-hidden="true" /> קו דק: ממוצע הסקרים מ-{fmtDate(table.avgDate)} · המספר הקטן:
            השינוי מהסקר האחרון של {c.name} שדווח לוועדת הבחירות (
            <a href={u(`/polls/${c.lastPoll.key}`)}>{fmtDate(c.lastPoll.field_date)}</a>).
          </p>
        )}

        <dl class="exit-scores">
          <div>
            <dt>מרחק מהסקר האחרון של הערוץ</dt>
            <dd>
              {c.vsLastPoll == null ? <Num value={null} missing="אין לערוץ סקר במאגר" /> : <><Num value={c.vsLastPoll} digits={digits(c.vsLastPoll)} /> מנדטים</>}
            </dd>
          </div>
          <div>
            <dt>מרחק מממוצע הסקרים</dt>
            <dd><Num value={c.vsAverage} digits={1} /> מנדטים</dd>
          </div>
          <div class="exit-accuracy">
            <dt>ציון דיוק מול התוצאות</dt>
            <dd>
              {c.accuracy == null ? (
                <span class="muted">אחרי פרסום התוצאות</span>
              ) : (
                <>
                  <Num value={c.accuracy} digits={digits(c.accuracy)} /> מנדטים
                  {c.accuracy === best && <span class="exit-best">המדויק ביותר</span>}
                </>
              )}
            </dd>
          </div>
        </dl>
        {c.latest.note && <p class="exit-note">{c.latest.note}</p>}
      </article>
    ))
  }

  <div class="exit-compare">
    <h2>כל המדגמים זה לצד זה</h2>
    <div class="table-wrap" tabindex="0" role="region" aria-label="טבלת כל המדגמים">
      <table class="exit-table">
        <caption class="sr-only">
          המנדטים לכל מפלגה בכל מדגם (הגרסה האחרונה), ממוצע המדגמים וממוצע הסקרים מ-{fmtDate(table.avgDate)}
        </caption>
        <thead>
          <tr>
            <th scope="col">מפלגה</th>
            {table.columns.map((col) => <th scope="col" class:list={["num", col.kind !== "exit" && "exit-col-ref"]}>{col.name}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            table.rows.map((r) => (
              <tr>
                <th scope="row"><span class="party-cell"><i class="swatch" style={`background: ${r.color}`} />{r.name}</span></th>
                {table.columns.map((col) => (
                  <td class:list={["num", col.kind !== "exit" && "exit-col-ref"]} data-gap={col.kind === "exit" ? gap(col.seats[r.id] ?? 0, pollsCol.seats[r.id] ?? 0) : undefined}>
                    <Num value={col.seats[r.id] ?? 0} digits={col.kind === "average" ? 1 : 0} />
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
        <tbody class="exit-blocs">
          {
            table.blocRows.map((b) => (
              <tr>
                <th scope="row"><span class="party-cell"><i class="swatch" style={`background: var(--bloc-${b.bloc})`} />{b.name}</span></th>
                {b.values.map((v, i) => (
                  <td class:list={["num", table.columns[i].kind !== "exit" && "exit-col-ref"]}>
                    <Num value={v} digits={table.columns[i].kind === "average" ? 1 : 0} />
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
        <tfoot>
          <tr>
            <th scope="row">מרחק מממוצע הסקרים</th>
            {table.columns.map((col) => (
              <td class:list={["num", col.kind !== "exit" && "exit-col-ref"]}>
                <Num value={seatDistance(col.seats, pollsCol.seats)} digits={1} />
              </td>
            ))}
          </tr>
          <tr class="exit-accuracy-row">
            <th scope="row">ציון דיוק מול התוצאות</th>
            {!results && <td colspan={table.columns.length} class="exit-pending">יחושב כשוועדת הבחירות תפרסם את תוצאות האמת</td>}
            {results && table.columns.map((col) => (
              <td class:list={["num", col.kind !== "exit" && "exit-col-ref", col.kind === "exit" && col.distance === best && "exit-best-cell"]}>
                <Num value={col.kind === "results" ? null : col.distance} digits={1} missing={col.kind === "results" ? "—" : "אחרי פרסום התוצאות"} />
              </td>
            ))}
          </tr>
        </tfoot>
      </table>
    </div>
    <p class="exit-key exit-heat-key">
      <span><i data-gap="up2" /> 2–3 מנדטים מעל ממוצע הסקרים</span>
      <span><i data-gap="up4" /> 4 ומעלה מעל</span>
      <span><i data-gap="down2" /> 2–3 מתחת</span>
      <span><i data-gap="down4" /> 4 ומעלה מתחת</span>
    </p>
    <p class="exit-key">
      המרחק והציון: כמה מנדטים צריכים לעבור בין מפלגות כדי שהמדגם יהיה זהה להשוואה; 0 הוא זהות מלאה, והנמוך יותר
      מדויק יותר. ממוצע הסקרים הוא הממוצע האחרון במאגר, מ-{fmtDate(table.avgDate)}.
      מקורות המדגמים (המדגמים אינם מדווחים לוועדת הבחירות):{" "}
      {sources.map((s, i) => <>{i > 0 && " · "}<a href={s} rel="noopener">{host(s)}</a></>)}
    </p>
  </div>
</section>

<script>
  // Tabs: one channel at a time. Without JS the overview still shows and every card is listed.
  const list = document.querySelector<HTMLElement>(".exit-tabs");
  if (list) {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute("aria-controls")!)!.hidden = !on;
      }
      if (focus) tab.focus();
    };
    select(tabs[0]);
    list.addEventListener("click", (e) => {
      const tab = (e.target as HTMLElement).closest<HTMLButtonElement>("[role=tab]");
      if (tab) select(tab);
    });
    list.addEventListener("keydown", (e) => {
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      // RTL: the next tab is to the left.
      const step = { ArrowLeft: 1, ArrowRight: -1, Home: -i, End: tabs.length - 1 - i }[e.key];
      if (step == null) return;
      e.preventDefault();
      select(tabs[(i + step + tabs.length) % tabs.length], true);
    });
  }
</script>
