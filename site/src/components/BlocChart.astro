---
import { blocChartData, BLOC_NAMES, average, fmtDate } from "../lib/data";
const data = blocChartData();
const id = "bloc-chart";
const rows = average.blocs.slice().reverse().filter((_, i) => i % 7 === 0);
---

<div class="legend" aria-hidden="true">
  {
    (["coalition", "opposition", "arab"] as const).map((b) => (
      <span>
        <i class="swatch" style={`background: var(--bloc-${b})`} />
        {BLOC_NAMES[b]}
      </span>
    ))
  }
  <span class="muted">· קו = ממוצע · רצועה = פיזור בין הסוקרים · נקודה = סקר</span>
</div>
<div class="chart" id={id} role="img" aria-label="ממוצע המנדטים לפי גוש לאורך זמן"></div>
<script type="application/json" data-for={id} set:html={JSON.stringify(data)} />
<details class="table-view">
  <summary>הצג כטבלה</summary>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>תאריך</th><th class="num">{BLOC_NAMES.coalition}</th><th class="num">{BLOC_NAMES.opposition}</th><th class="num">{BLOC_NAMES.arab}</th><th class="num">{BLOC_NAMES.other}</th><th class="num">סוקרים</th></tr>
      </thead>
      <tbody>
        {
          rows.map((d) => (
            <tr>
              <td>{fmtDate(d.date)}</td>
              {(["coalition", "opposition", "arab", "other"] as const).map((b) => (
                <td class="num">{d.values[b]?.mean.toFixed(1) ?? "—"}</td>
              ))}
              <td class="num">{d.n_polls}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</details>

<script>
  import { blocChart, mount } from "../scripts/charts";
  const el = document.getElementById("bloc-chart")!;
  const data = JSON.parse(document.querySelector('script[data-for="bloc-chart"]')!.textContent!);
  mount(el, (w) => blocChart(data, w));
</script>
