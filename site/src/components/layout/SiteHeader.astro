---
// Logo, primary navigation and the theme switch. On narrow screens the navigation moves
// into a <dialog> behind a ≡ button; without JS it stays inline and wraps.
interface Props {
  current: string;
}
import Logo from "./Logo.astro";

const { current } = Astro.props;
const nav = [
  ["/", "ממוצע"],
  ["/trends", "מגמות"],
  ["/polls", "סקרים"],
  ["/pollsters", "סוקרים"],
  ["/methodology", "מתודולוגיה"],
];
const isCurrent = (href: string) =>
  href === "/" ? current === "/" : current === href || current.startsWith(href + "/");
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">
      <Logo />
      <span class="brand-sub">סקרי הבחירות לכנסת ה-26</span>
    </a>
    <nav class="nav" aria-label="ניווט ראשי">
      {
        nav.map(([href, label]) => (
          <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
            {label}
          </a>
        ))
      }
    </nav>
    <div class="header-tools">
      <button class="icon-btn theme-toggle" type="button" aria-pressed="false" title="מצב כהה">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2" />
          <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" />
        </svg>
        <span class="sr-only">מצב כהה</span>
      </button>
      <button class="icon-btn nav-toggle" type="button" aria-haspopup="dialog" aria-controls="nav-dialog">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span class="sr-only">תפריט</span>
      </button>
    </div>
  </div>
  <dialog class="nav-dialog" id="nav-dialog" aria-label="תפריט">
    <div class="nav-dialog-head">
      <Logo height={22} />
      <button class="icon-btn" type="button" data-close>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span class="sr-only">סגירת התפריט</span>
      </button>
    </div>
    <nav aria-label="ניווט ראשי">
      <ul>
        {
          nav.map(([href, label]) => (
            <li>
              <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </dialog>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle")!;
  const system = matchMedia("(prefers-color-scheme: dark)");
  const isDark = () => (root.dataset.theme ? root.dataset.theme === "dark" : system.matches);
  const sync = () => toggle.setAttribute("aria-pressed", String(isDark()));
  toggle.addEventListener("click", () => {
    const next = isDark() ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
    sync();
  });
  system.addEventListener("change", sync);
  sync();

  const dialog = document.getElementById("nav-dialog") as HTMLDialogElement;
  document.querySelector(".nav-toggle")!.addEventListener("click", () => dialog.showModal());
  dialog.querySelector("[data-close]")!.addEventListener("click", () => dialog.close());
  // Clicking the backdrop (outside the panel) closes the menu.
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });
  matchMedia("(min-width: 768px)").addEventListener("change", (e) => e.matches && dialog.close());
</script>
