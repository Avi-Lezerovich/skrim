---
// Compact sticky header: logo and theme switch. The one primary <nav> is a bottom tab bar on
// phones (thumb reach, five sections) and moves into the header row from 768px; it is plain
// links, so it works without JS.
import Logo from "./Logo.astro";
import { u } from "../../lib/url";

interface Props {
  current: string;
}
const { current } = Astro.props;
// Icons are 24×24 line drawings in currentColor, shown only in the tab bar.
const nav = [
  ["/", "ממוצע", "M3 9h18v6H3zM12 5v14"],
  ["/trends", "מגמות", "M3 18l5-6 4 3 8-9M3 21h18"],
  ["/polls", "סקרים", "M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"],
  ["/pollsters", "סוקרים", "M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM3 19c0-3 2.7-5 6-5s6 2 6 5M16 11a2.5 2.5 0 1 0 0-5M17.5 14c2.2.5 3.5 2.3 3.5 5"],
  ["/methodology", "מתודולוגיה", "M5 4h10l4 4v12H5zM15 4v4h4M8 12h8M8 16h6"],
];
const isCurrent = (href: string) =>
  href === "/" ? current === "/" : current === href || current.startsWith(href + "/");
---

<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href={u("/")}>
      <Logo />
      <span class="brand-sub">סקרי הבחירות לכנסת ה-26</span>
    </a>
    <nav class="nav" aria-label="ניווט ראשי">
      {
        nav.map(([href, label, icon]) => (
          <a href={u(href)} aria-current={isCurrent(href) ? "page" : undefined}>
            <svg class="nav-icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
              <path d={icon} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>{label}</span>
          </a>
        ))
      }
    </nav>
    <button class="icon-btn theme-toggle" type="button" aria-pressed="false" title="מצב כהה">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2" />
        <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" />
      </svg>
      <span class="sr-only">מצב כהה</span>
    </button>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle")!;
  const system = matchMedia("(prefers-color-scheme: dark)");
  const isDark = () => (root.dataset.theme ? root.dataset.theme === "dark" : system.matches);
  const metas = document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]');
  const sync = () => {
    toggle.setAttribute("aria-pressed", String(isDark()));
    // A theme picked by hand overrides the media-matched browser chrome colour.
    if (root.dataset.theme) for (const m of metas) m.content = isDark() ? "#1a1a19" : "#ffffff";
  };
  toggle.addEventListener("click", () => {
    const next = isDark() ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
    sync();
  });
  system.addEventListener("change", sync);
  sync();
</script>
