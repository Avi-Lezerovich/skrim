---
import { u } from "../lib/url";
import Base from "../layouts/Base.astro";
import BlocChart from "../components/charts/BlocChart.astro";
import BlocTile from "../components/summary/BlocTile.astro";
import ExitPolls from "../components/summary/ExitPolls.astro";
import Fold from "../components/layout/Fold.astro";
import PollsCompact from "../components/summary/PollsCompact.astro";
import SeatBars from "../components/summary/SeatBars.astro";
import SeatStrip from "../components/summary/SeatStrip.astro";
import { average, exitPolls, fmtDate, latestParties, polls, pollsterName } from "../lib/data";

/** Tile labels on phones, where three tiles share one row. */
const BLOC_TILE = { coalition: "קואליציה", opposition: "אופוזיציה", arab: "ערביות", other: "אחרות" } as const;
import { THRESHOLD_SEATS, blocTiles, isFinal, partyRows, stripSegments } from "../lib/selectors";

const date = latestParties.date;
const nPollsters = latestParties.n_polls;
// The averaging window ends on the average's date and spans window_days days, both ends included.
const windowStart = new Date(new Date(date).getTime() - (average.window_days - 1) * 86_400_000).toISOString().slice(0, 10);
const fmtDay = (iso: string) => new Intl.DateTimeFormat("he-IL", { day: "numeric", month: "numeric", timeZone: "UTC" }).format(new Date(iso));
const inWindow = latestParties.pollsters.map((id) => pollsterName(id)).join(", ");
const { above, around, windowSize } = partyRows();
const recent = polls.slice(0, 5);
/** Election night: once polls close and exit polls are in, they lead the page. */
const showExit = isFinal() && exitPolls.channels.length > 0;
---

<Base
  title={showExit ? "הערוצים בליל הבחירות · הכנסת ה-26" : "skrim · סקרי הבחירות לכנסת ה-26"}
  description={showExit
    ? "המדגמים והסקרים של כאן 11, חדשות 12, חדשות 13, ערוץ 14, i24NEWS וערוץ 16 בליל הבחירות, זה לצד זה, מול הסקרים האחרונים, ובהמשך מול התוצאות"
    : "ממוצע סקרי הבחירות לכנסת ה-26, לפי הדיווחים לוועדת הבחירות המרכזית"}
>
  {showExit && <ExitPolls />}

  {/* On election night the exit polls lead the page; the average follows with a short heading. */}
  {
    showExit ? (
      <header class="home-blocs-head">
        <h2>הממוצע הסופי לפני הבחירות</h2>
        <p class="page-meta">נכון ל-<time datetime={date}>{fmtDate(date)}</time>, יום הביצוע של הסקר האחרון</p>
      </header>
    ) : (
      <header class="page-head">
        <h1>{isFinal() ? "הממוצע הסופי לפני הבחירות" : "ממוצע הסקרים"}</h1>
        <p class="page-meta">
          ממוצע נכון ל-<time datetime={date}>{fmtDate(date)}</time>, יום הביצוע של הסקר האחרון · {nPollsters} סוקרים בחלון{" "}
          <bdi dir="ltr">{fmtDay(windowStart)}–{fmtDay(date)}</bdi>
        </p>
        {
          nPollsters < 3 && (
            <p class="notice">ממוצע על בסיס מעט סוקרים: כל סקר בודד משפיע עליו הרבה.</p>
          )
        }
        <details class="page-note window-note">
          <summary>הממוצע משקלל את הסקר האחרון של כל סוקר בחלון</summary>
          <p>
            הסוקרים בחלון: {inWindow}. <a href={u("/methodology#ממוצע-הסקרים")}>איך מחושב הממוצע</a>
          </p>
        </details>
      </header>
    )
  }

  <section class="home-blocs" aria-labelledby="blocs-h">
    <h2 id="blocs-h" class="sr-only">הגושים</h2>
    <div class="tiles">
      {blocTiles().map((t) => <BlocTile tile={t} short={BLOC_TILE[t.bloc]} />)}
    </div>
    <p class="tiles-key">מספר גדול: מנדטים בממוצע · מספר קטן: הפיזור בין הסוקרים · קו: 30 הימים האחרונים</p>
    <SeatStrip segments={stripSegments()} />
  </section>

  <Fold folded={showExit} summary="הממוצע לפי מפלגה וגרף הגושים לאורך זמן" class="home-more">
  <div class="home-split">
    <section class="card home-parties" aria-labelledby="parties-h">
      <h2 id="parties-h">מנדטים לפי מפלגה</h2>
      <p class="legend-key small">
        עמודה = ממוצע · קו כהה = פיזור בין הסוקרים · קו מקווקו = אחוז החסימה ({THRESHOLD_SEATS} מנדטים)
      </p>
      <SeatBars rows={above.slice(0, 12)} />
      {
        around.length > 0 && (
          <div class="around">
            <h3>סביב אחוז החסימה</h3>
            <ul>
              {around.map((r) => (
                <li>
                  <a href={u(`/trends#party-${r.id}`)}>
                    <i class="swatch" style={`background: ${r.color}`} />
                    {r.name}
                  </a>{" "}
                  — עוברת את החסימה ב-{r.passing} מתוך {windowSize} הסקרים בחלון
                </li>
              ))}
            </ul>
            <p class="small muted">
              מפלגה שעוברת את אחוז החסימה מקבלת לפחות {THRESHOLD_SEATS} מנדטים, ומפלגה שלא עוברת מקבלת 0, ולכן ממוצע
              מנדטים אינו מתאר אותה היטב.
            </p>
          </div>
        )
      }
    </section>
    <BlocChart />
  </div>
  </Fold>

  <section class="recent-polls" aria-labelledby="recent-h">
    <h2 id="recent-h">הסקרים האחרונים</h2>
    <div class="card card-flush">
      <PollsCompact polls={recent} caption="חמשת הסקרים האחרונים לפי תאריך ביצוע, עם סך המנדטים לכל גוש" />
    </div>
    <p class="more-link"><a href={u("/polls")}>כל {polls.length} הסקרים ←</a></p>
  </section>

  <p class="trust-line">
    כל מספר מקושר לדיווח המקורי בוועדת הבחירות · <a href={u("/methodology")}>מתודולוגיה</a> ·
    <a href={u("/data")}>הורדת הנתונים</a>
  </p>
</Base>
