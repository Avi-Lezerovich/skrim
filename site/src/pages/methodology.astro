---
import { execFileSync } from "node:child_process";
import Base from "../layouts/Base.astro";
import { Content, getHeadings } from "../../../methodology.md";
import { average } from "../lib/data";

const REPO = "https://github.com/Avi-Lezerovich/pollygraph-il";
const toc = getHeadings().filter((h) => h.depth === 2);

// Change log of methodology.md, read from git at build time. A shallow clone yields fewer
// entries (or none), so the page always links to the full history as well.
let changes: { hash: string; date: string; subject: string }[] = [];
try {
  changes = execFileSync("git", ["log", "--format=%h%x09%ad%x09%s", "--date=short", "--", "../methodology.md"], {
    encoding: "utf8",
  })
    .trim()
    .split("\n")
    .filter(Boolean)
    .map((line) => {
      const [hash, date, subject] = line.split("\t");
      return { hash, date, subject };
    });
} catch {
  changes = [];
}
const fmt = (iso: string) => iso.split("-").reverse().map(Number).join(".");
---

<Base title="מתודולוגיה" description="איך נאספו, חולצו ונותחו הסקרים, ומה המגבלות">
  <header class="page-head">
    <h1>מתודולוגיה</h1>
    <p class="page-note">איך בדיוק חושב כל מספר באתר, ומה המגבלות. המסמך המלא נשמר ב-git, וכל שינוי בו מתועד למטה.</p>
  </header>

  <section class="card method-summary" aria-labelledby="summary-h">
    <h2 id="summary-h">בקצרה</h2>
    <ol>
      <li>המקור הוא הדיווחים שהסוקרים מגישים לוועדת הבחירות המרכזית. כל סקר באתר מקושר ל-PDF המקורי.</li>
      <li>
        הנתונים מחולצים אוטומטית מטקסט ה-PDF ועוברים בקרות. סקר שנכשל בבקרה ממתין לבדיקה ידנית ואינו נכלל
        בממוצע.
      </li>
      <li>
        הממוצע לוקח את הסקר האחרון של כל סוקר מ-{average.window_days} הימים האחרונים, במשקל לפי <bdi dir="ltr">√n</bdi> ובדעיכה של
        חצי כל {average.half_life_days} ימים.
      </li>
      <li>הרצועה סביב הממוצע היא הפיזור בין הסוקרים, לא רווח בטחון ולא טווח שבו צפויה התוצאה.</li>
      <li>
        «אפקט בית» מראה במה סוקר שונה משאר הסוקרים, לא מי מדויק. את הדיוק אפשר יהיה למדוד רק מול התוצאות
        הרשמיות.
      </li>
    </ol>
  </section>

  <div class="method-layout">
    <details class="method-toc-mobile">
      <summary>תוכן העניינים</summary>
      <nav aria-label="תוכן העניינים">
        <ol>
          {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          <li><a href="#changes">יומן שינויים</a></li>
        </ol>
      </nav>
    </details>

    <article class="prose methodology-body">
      <Content />

      <h2 id="changes">יומן שינויים</h2>
      {
        changes.length > 0 ? (
          <ol class="change-log">
            {changes.map((c) => (
              <li>
                <time datetime={c.date}>{fmt(c.date)}</time> ·{" "}
                <a href={`${REPO}/commit/${c.hash}`}>
                  <code dir="ltr">{c.hash}</code>
                </a>{" "}
                <span lang="en" dir="ltr">{c.subject}</span>
              </li>
            ))}
          </ol>
        ) : (
          <p class="muted">לא ניתן היה לקרוא את ההיסטוריה בזמן הבנייה.</p>
        )
      }
      <p><a href={`${REPO}/commits/main/methodology.md`}>ההיסטוריה המלאה של המסמך ב-GitHub</a></p>

      <p class="report-box">
        מצאתם טעות במספר, בחישוב או בניסוח? <a href={`${REPO}/issues/new`}>פתחו דיווח ב-GitHub</a>
      </p>
    </article>

    <nav class="method-toc" aria-label="תוכן העניינים">
      <p class="method-toc-title">תוכן</p>
      <ol>
        {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        <li><a href="#changes">יומן שינויים</a></li>
      </ol>
    </nav>
  </div>
</Base>

<script>
  // Mark the section being read in the desktop table of contents.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>(".method-toc a")].map((a) => [decodeURIComponent(a.hash.slice(1)), a]),
  );
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        for (const a of links.values()) a.removeAttribute("aria-current");
        links.get(e.target.id)?.setAttribute("aria-current", "location");
      }
    },
    { rootMargin: "0px 0px -70% 0px" },
  );
  for (const id of links.keys()) {
    const h = document.getElementById(id);
    if (h) io.observe(h);
  }
</script>
