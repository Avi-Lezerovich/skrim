---
import { execFileSync } from "node:child_process";
import { readFileSync } from "node:fs";
import Base from "../layouts/Base.astro";
import { Content, getHeadings } from "../../../methodology.md";
import { average } from "../lib/data";
import { EMBARGO_END } from "../lib/embargo.mjs";
import { REPO } from "../lib/url";

const toc = getHeadings().filter((h) => h.depth === 2);

/** `git log` at build time, one tab-separated row per commit; none when git or the history is missing. */
const gitLog = (args: string[]) => {
  try {
    return execFileSync("git", ["log", ...args], { encoding: "utf8" })
      .trim()
      .split("\n")
      .filter(Boolean)
      .map((line) => line.split("\t"));
  } catch {
    return [];
  }
};

// Change log of methodology.md. Merge commits are left out (CI builds a PR's merge commit, whose
// subject is two full hashes). A shallow clone yields fewer entries (or none), so the page
// always links to the full history as well.
const changes = gitLog(["--no-merges", "--date=short", "--format=%h%x09%ad%x09%s", "--", "../methodology.md"]).map(
  ([hash, date, subject]) => ({ hash, date, subject }),
);

// The last change to the accuracy rules: the body of «ציון דיוק», from its first rule to its
// last non-empty line, so neither an edit to its heading nor a section added after it counts.
// Committer time, so a rebased commit is dated when it landed. Only with full history: a shallow
// clone blames its boundary commit for every line, which would date the rules to the build.
const lines = readFileSync("../methodology.md", "utf8").split("\n");
const first = lines.findIndex((l) => l.startsWith("**סקר אחרון:**"));
const next = lines.findIndex((l, i) => i > first && l.startsWith("## "));
let last = next - 1;
while (last > first && !lines[last].trim()) last--;
let shallow = true;
try {
  shallow = execFileSync("git", ["rev-parse", "--is-shallow-repository"], { encoding: "utf8" }).trim() !== "false";
} catch {}
const [rules] =
  shallow || first < 0 || next < 0
    ? []
    : gitLog(["-1", "-s", "--format=%H%x09%cI", `-L${first + 1},${last + 1}:../methodology.md`]).map(([hash, time]) => ({ hash, time }));
if (!shallow && !rules) throw new Error("methodology: no git history for the «ציון דיוק» rules; check the -L range above");
const rulesBefore = rules && new Date(rules.time) < EMBARGO_END;
const fmt = (iso: string) => iso.split("-").reverse().map(Number).join(".");
---

<Base title="מתודולוגיה" description="איך נאספו, חולצו ונותחו הסקרים, ומה המגבלות">
  <header class="page-head">
    <h1>מתודולוגיה</h1>
    <p class="page-note">איך בדיוק חושב כל מספר באתר, ומה המגבלות. המסמך המלא נשמר ב-git, וכל שינוי בו מתועד למטה.</p>
  </header>

  <section class="card method-summary" aria-labelledby="summary-h">
    <h2 id="summary-h">בקצרה</h2>
    <ol>
      <li>המקור הוא הדיווחים שהסוקרים מגישים לוועדת הבחירות המרכזית. כל סקר באתר מקושר ל-PDF המקורי.</li>
      <li>
        הנתונים מחולצים אוטומטית מטקסט ה-PDF ועוברים בקרות. סקר שנכשל בבקרה ממתין לבדיקה ידנית ואינו נכלל
        בממוצע.
      </li>
      <li>
        הממוצע לוקח את הסקר האחרון של כל סוקר מ-{average.window_days} הימים האחרונים, במשקל לפי <bdi dir="ltr">√n</bdi> ובדעיכה של
        חצי כל {average.half_life_days} ימים.
      </li>
      <li>הרצועה סביב הממוצע היא הפיזור בין הסוקרים, לא רווח בטחון ולא טווח שבו צפויה התוצאה.</li>
      <li>
        «אפקט בית» מראה במה סוקר שונה משאר הסוקרים, לא מי מדויק. את הדיוק אפשר יהיה למדוד רק מול התוצאות
        הרשמיות.
      </li>
    </ol>
  </section>

  <div class="method-layout">
    <details class="method-toc-mobile">
      <summary>תוכן העניינים</summary>
      <nav aria-label="תוכן העניינים">
        <ol>
          {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          <li><a href="#changes">יומן שינויים</a></li>
        </ol>
      </nav>
    </details>

    <article class="prose methodology-body">
      {
        rules && (
          <blockquote>
            <p>
              {rulesBefore ? (
                <>
                  <strong>הכללים נקבעו לפני הבחירות.</strong> הנוסחה של <a href="#ציון-דיוק">ציון הדיוק</a> וההגדרה
                  של «סקר אחרון» לא השתנו מאז <a href={`${REPO}/commit/${rules.hash}`}>{fmt(rules.time.slice(0, 10))}</a>, לפני יום
                  הבחירות. אחרי הבחירות הוסרה מכותרת הסעיף רק ההערה «טיוטה».
                </>
              ) : (
                <>
                  <strong>כללי <a href="#ציון-דיוק">ציון הדיוק</a> שונו אחרי הבחירות</strong>,
                  ב-<a href={`${REPO}/commit/${rules.hash}`}>{fmt(rules.time.slice(0, 10))}</a>. השינוי מתועד ביומן השינויים בתחתית הדף.
                </>
              )}
            </p>
          </blockquote>
        )
      }
      <Content />

      <h2 id="changes">יומן שינויים</h2>
      {
        changes.length > 0 ? (
          <ol class="change-log">
            {changes.map((c) => (
              <li>
                <time datetime={c.date}>{fmt(c.date)}</time> ·{" "}
                <a href={`${REPO}/commit/${c.hash}`}>
                  <code dir="ltr">{c.hash}</code>
                </a>{" "}
                <span lang="en" dir="ltr">{c.subject}</span>
              </li>
            ))}
          </ol>
        ) : (
          <p class="muted">לא ניתן היה לקרוא את ההיסטוריה בזמן הבנייה.</p>
        )
      }
      <p><a href={`${REPO}/commits/main/methodology.md`}>ההיסטוריה המלאה של המסמך ב-GitHub</a></p>

      <p class="report-box">
        מצאתם טעות במספר, בחישוב או בניסוח? <a href={`${REPO}/issues/new`}>פתחו דיווח ב-GitHub</a>
      </p>
    </article>

    <nav class="method-toc" aria-label="תוכן העניינים">
      <p class="method-toc-title">תוכן</p>
      <ol>
        {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        <li><a href="#changes">יומן שינויים</a></li>
      </ol>
    </nav>
  </div>
</Base>

<script>
  // Mark the section being read in the desktop table of contents.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>(".method-toc a")].map((a) => [decodeURIComponent(a.hash.slice(1)), a]),
  );
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        for (const a of links.values()) a.removeAttribute("aria-current");
        links.get(e.target.id)?.setAttribute("aria-current", "location");
      }
    },
    { rootMargin: "0px 0px -70% 0px" },
  );
  for (const id of links.keys()) {
    const h = document.getElementById(id);
    if (h) io.observe(h);
  }
</script>
