---
import { u } from "../../lib/url";
import Base from "../../layouts/Base.astro";
import FlagBadge from "../../components/data/FlagBadge.astro";
import Num from "../../components/data/Num.astro";
import PollsCompact from "../../components/summary/PollsCompact.astro";
import {
  BLOC_SHORT,
  fmtDate,
  okPolls,
  partyName,
  pollsterName,
  polls,
  sponsorName,
  trendParties,
  type Poll,
} from "../../lib/data";

const cols = trendParties.slice(0, 14);
const blocs = ["coalition", "opposition", "arab"] as const;
const opts = (pairs: [string, string][]) =>
  [...new Map(pairs).entries()].sort((a, b) => a[1].localeCompare(b[1], "he"));
const pollsterOpts = opts(polls.map((p) => [p.pollster ?? "", pollsterName(p.pollster, p.pollster_raw)]));
const sponsorOpts = opts(polls.map((p) => [p.sponsor ?? "", sponsorName(p.sponsor, p.sponsor_raw)]));
const review = polls.length - okPolls.length;
const notes = (p: Poll) => p.flags.filter((f) => f.level !== "error");
const sortOptions = [
  ["date:desc", "תאריך ביצוע, מהחדש"],
  ["date:asc", "תאריך ביצוע, מהישן"],
  ["transfer:desc", "תאריך העברה לוועדה, מהחדש"],
  ["pollster:asc", "סוקר (א–ת)"],
  ["sponsor:asc", "מזמין (א–ת)"],
  ["n:desc", "מספר משיבים, מהגדול"],
];
---

<Base title="כל הסקרים" description="כל סקרי הבחירות לכנסת ה-26 שהוגשו לוועדת הבחירות, עם סינון, מיון והורדה">
  <header class="page-head">
    <h1>כל הסקרים</h1>
    <p class="page-meta">
      {polls.length} סקרים שהוגשו לוועדה · {okPolls.length} בממוצע · {review} ממתינים לבדיקה ידנית
    </p>
    <p class="page-note">
      כל סקר מקושר לדף משלו ולדיווח המקורי (PDF) בוועדת הבחירות. סקר שממתין לבדיקה מוצג באפור ואינו נכלל
      בממוצע.
    </p>
  </header>

  {/* Phones: the form is a bottom sheet behind the sticky bar's button. From 768px (and
      without JS) the same form sits inline above the table. */}
  <dialog class="filter-sheet" id="filter-sheet" aria-labelledby="filter-sheet-title">
  <div class="sheet-head">
    <h2 id="filter-sheet-title">סינון ומיון</h2>
    <button type="button" class="icon-btn" data-close>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      <span class="sr-only">סגירה</span>
    </button>
  </div>
  <form class="filters" id="poll-filters" role="search" aria-label="סינון ומיון הסקרים">
    <label>סוקר
      <select name="pollster"><option value="">הכול</option>{pollsterOpts.map(([v, l]) => <option value={v}>{l}</option>)}</select>
    </label>
    <label>מזמין
      <select name="sponsor"><option value="">הכול</option>{sponsorOpts.map(([v, l]) => <option value={v}>{l}</option>)}</select>
    </label>
    <label>מתאריך ביצוע <input type="date" name="from" /></label>
    <label>עד תאריך <input type="date" name="to" /></label>
    <label>סטטוס
      <select name="status">
        <option value="">הכול</option>
        <option value="ok">בממוצע</option>
        <option value="review">ממתינים לבדיקה</option>
      </select>
    </label>
    <label>מיון
      <select name="sort">
        {sortOptions.map(([v, l]) => <option value={v}>{l}</option>)}
        <option value="" hidden>לפי עמודה בטבלה</option>
      </select>
    </label>
    <div class="sheet-actions">
      <button type="reset">נקה סינון</button>
      <button type="button" class="btn-primary" data-close>הצגת <span class="sheet-n">{polls.length}</span> סקרים</button>
    </div>
  </form>
  </dialog>

  <div class="filter-bar">
    <button type="button" class="filter-open" aria-haspopup="dialog" aria-controls="filter-sheet">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M7 12h10M10 17h4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      סינון ומיון<span class="filter-n" hidden></span>
    </button>
    <p class="filter-count" id="f-count" aria-live="polite">{polls.length} סקרים</p>
    <ul class="filter-chips" aria-label="סינון פעיל"></ul>
  </div>
  <div class="list-bar">
    <p class="downloads">
      <span>הורדה:</span>
      <a href={u("/data/polls.csv")} download="knesset26-polls.csv">כל הסקרים (CSV)</a>
      <button type="button" class="link-btn" id="csv-filtered">הסינון הנוכחי (CSV)</button>
      <a href={u("/data/answers.csv")} download="knesset26-answers.csv">מפלגה × סקר (CSV)</a>
    </p>
  </div>

  <div class="empty-state" id="f-empty" hidden>
    <p>אין סקרים שמתאימים לסינון.</p>
    <button type="button" id="f-empty-clear">נקה סינון</button>
  </div>

  <div class="table-wrap tall polls-table-wrap" tabindex="0" role="region" aria-label="טבלת הסקרים">
    <table id="polls-table" class="polls-table">
      <caption class="sr-only">כל הסקרים. הכפתורים בכותרות העמודות ממיינים את הטבלה.</caption>
      <thead>
        <tr>
          <th scope="col" data-col="date" aria-sort="descending"><button type="button">תאריך ביצוע<span class="sort-ind" aria-hidden="true"></span></button></th>
          <th scope="col" data-col="pollster"><button type="button">סוקר<span class="sort-ind" aria-hidden="true"></span></button></th>
          <th scope="col" data-col="sponsor"><button type="button">מזמין<span class="sort-ind" aria-hidden="true"></span></button></th>
          <th scope="col" data-col="transfer"><button type="button">הועבר לוועדה<span class="sort-ind" aria-hidden="true"></span></button></th>
          <th scope="col" data-col="n" class="num"><button type="button">משיבים<span class="sort-ind" aria-hidden="true"></span></button></th>
          {blocs.map((b) => <th scope="col" data-col={b} class="num bloc-col"><button type="button">{BLOC_SHORT[b]}<span class="sort-ind" aria-hidden="true"></span></button></th>)}
          {cols.map((id) => <th scope="col" data-col={`party:${id}`} class="num"><button type="button">{partyName(id)}<span class="sort-ind" aria-hidden="true"></span></button></th>)}
          <th scope="col">דגלים</th>
          <th scope="col">מקור</th>
        </tr>
      </thead>
      <tbody>
        {
          polls.map((p) => {
            const isReview = p.status !== "ok";
            const pollster = pollsterName(p.pollster, p.pollster_raw);
            return (
              <tr
                class:list={{ "is-review": isReview }}
                data-key={p.key}
                data-pollster={p.pollster ?? ""}
                data-sponsor={p.sponsor ?? ""}
                data-date={p.field_date ?? ""}
                data-status={isReview ? "review" : "ok"}
              >
                <td data-v={p.field_date ?? ""}>
                  <a href={u(`/polls/${p.key}`)}>{fmtDate(p.field_date)}</a>
                  {isReview && <FlagBadge level="review" />}
                </td>
                <td data-v={pollster}>{pollster}</td>
                <td data-v={sponsorName(p.sponsor, p.sponsor_raw)}>{sponsorName(p.sponsor, p.sponsor_raw)}</td>
                <td data-v={p.transfer_date ?? ""}>{fmtDate(p.transfer_date)}</td>
                <td class="num" data-v={p.meta.respondents ?? ""}><Num value={p.meta.respondents} kind="int" missing="לא אותר בחילוץ" /></td>
                {blocs.map((b) => (
                  <td class="num bloc-col" data-v={p.blocs?.[b] ?? ""}>
                    <Num value={p.blocs?.[b]} missing={isReview ? "לא בממוצע — ממתין לבדיקה" : "לא דווח"} />
                  </td>
                ))}
                {cols.map((id) => (
                  <td class="num" data-v={p.seats[id] ?? ""}>
                    <Num value={p.seats[id]} missing={isReview ? "לא בממוצע — ממתין לבדיקה" : "המפלגה לא הופיעה בסקר"} />
                  </td>
                ))}
                <td>
                  {!isReview && (
                    <FlagBadge level={notes(p).some((f) => f.level === "warn") ? "warn" : "info"} count={notes(p).length} />
                  )}
                </td>
                <td>
                  <a href={p.source_url}>
                    PDF<span class="sr-only"> — הדיווח של {pollster} מ-{fmtDate(p.field_date)}</span>
                    <span aria-hidden="true"> ↗</span>
                  </a>
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>

  <div class="card card-flush polls-compact-wrap">
    <PollsCompact polls={polls} id="poll-compact" caption="כל הסקרים, עם סך המנדטים לכל גוש. לסינון ולמיון: כפתור «סינון ומיון»." />
  </div>
  <p class="more-polls"><button type="button" id="f-more" hidden>הצגת עוד סקרים</button></p>
</Base>

<script>
  import { u } from "../../lib/url";

  const form = document.getElementById("poll-filters") as HTMLFormElement;
  const table = document.getElementById("polls-table") as HTMLTableElement;
  const tbody = table.tBodies[0];
  const rows = [...tbody.rows];
  const compact = (document.getElementById("poll-compact") as HTMLTableElement).tBodies[0];
  const lines = new Map([...compact.rows].map((r) => [r.dataset.key!, r]));
  const sheet = document.getElementById("filter-sheet") as HTMLDialogElement;
  const chips = document.querySelector(".filter-chips")!;
  const badge = document.querySelector<HTMLElement>(".filter-n")!;
  const more = document.getElementById("f-more") as HTMLButtonElement;
  const sheetN = document.querySelector(".sheet-n")!;
  // The phone list shows PAGE matching polls at a time.
  const PAGE = 30;
  let pages = 1;
  const heads = [...table.tHead!.rows[0].cells];
  const count = document.getElementById("f-count")!;
  const empty = document.getElementById("f-empty")!;
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement;
  const FILTERS = ["pollster", "sponsor", "from", "to", "status"];

  let sort = { col: "date", dir: "desc" as "asc" | "desc" };

  // Restore filters and sort from the URL, so a filtered view can be shared.
  const params = new URLSearchParams(location.search);
  for (const name of FILTERS) if (params.has(name)) field(name).value = params.get(name)!;
  const s = params.get("sort")?.split(":");
  if (s && heads.some((h) => h.dataset.col === s[0])) sort = { col: s[0], dir: s[1] === "asc" ? "asc" : "desc" };

  const cellValue = (r: HTMLTableRowElement, i: number) => r.cells[i].dataset.v ?? "";

  function sortRows(list: HTMLTableRowElement[]) {
    const i = heads.findIndex((h) => h.dataset.col === sort.col);
    const sign = sort.dir === "asc" ? 1 : -1;
    return list.sort((a, b) => {
      const x = cellValue(a, i), y = cellValue(b, i);
      if (x === "" || y === "") return x === y ? 0 : x === "" ? 1 : -1; // missing values last
      const nx = Number(x), ny = Number(y);
      const c = Number.isFinite(nx) && Number.isFinite(ny) ? nx - ny : x.localeCompare(y, "he");
      return c * sign || cellValue(b, 0).localeCompare(cellValue(a, 0));
    });
  }

  const key0 = () => `${sort.col}:${sort.dir}`;
  const LABELS: Record<string, string> = { pollster: "סוקר", sponsor: "מזמין", from: "מ-", to: "עד", status: "סטטוס", sort: "מיון" };
  const optionText = (name: string) => {
    const el = field(name);
    if (el instanceof HTMLSelectElement) return el.selectedOptions[0]?.textContent?.trim() ?? el.value;
    const [y, m, d] = el.value.split("-");
    return `${+d}.${+m}.${y}`;
  };

  /** One removable chip per active filter (and a non-default sort), plus the count on the button. */
  function renderChips(v: Record<string, string>, key: string) {
    chips.replaceChildren();
    const active = FILTERS.filter((n) => v[n]);
    if (key !== "date:desc") active.push("sort");
    for (const name of active) {
      const li = document.createElement("li");
      const b = Object.assign(document.createElement("button"), { type: "button", className: "chip" });
      const text = name === "sort" ? (field("sort").value ? optionText("sort") : "לפי עמודה") : optionText(name);
      b.innerHTML = `<span>${LABELS[name]}${name === "from" || name === "to" ? "" : ":"} <bdi></bdi></span><span aria-hidden="true">✕</span>`;
      b.querySelector("bdi")!.textContent = text;
      b.setAttribute("aria-label", `הסרת הסינון ${LABELS[name]} ${text}`);
      b.addEventListener("click", () => {
        if (name === "sort") sort = { col: "date", dir: "desc" };
        else field(name).value = "";
        pages = 1;
        apply();
        (chips.querySelector("button") ?? document.querySelector<HTMLElement>(".filter-open"))!.focus();
      });
      li.append(b);
      chips.append(li);
    }
    badge.hidden = active.length === 0;
    badge.textContent = ` (${active.length})`;
  }

  function apply() {
    const v = Object.fromEntries(FILTERS.map((n) => [n, field(n).value]));
    let shown = 0;
    for (const r of rows) {
      const d = r.dataset;
      const ok =
        (!v.pollster || d.pollster === v.pollster) &&
        (!v.sponsor || d.sponsor === v.sponsor) &&
        (!v.from || (d.date ?? "") >= v.from) &&
        (!v.to || (d.date ?? "") <= v.to) &&
        (!v.status || d.status === v.status);
      r.hidden = !ok;
      lines.get(d.key!)!.hidden = !ok;
      if (ok) shown++;
    }
    let n = 0;
    for (const r of sortRows(rows)) {
      tbody.append(r);
      const line = lines.get(r.dataset.key!)!;
      compact.append(line);
      if (!line.hidden) line.classList.toggle("is-later", ++n > pages * PAGE);
    }
    const rest = shown - pages * PAGE;
    more.hidden = rest <= 0;
    more.textContent = `הצגת עוד ${Math.min(PAGE, rest)} סקרים (מתוך ${rest})`;
    sheetN.textContent = String(shown);
    renderChips(v, key0());
    for (const h of heads) {
      if (!h.dataset.col) continue;
      if (h.dataset.col === sort.col) h.setAttribute("aria-sort", sort.dir === "asc" ? "ascending" : "descending");
      else h.removeAttribute("aria-sort");
    }
    const key = key0();
    const sel = field("sort") as HTMLSelectElement;
    sel.value = [...sel.options].some((o) => o.value === key) ? key : "";
    count.textContent = shown === rows.length ? `${shown} סקרים` : `מוצגים ${shown} מתוך ${rows.length} סקרים`;
    empty.hidden = shown > 0;

    const q = new URLSearchParams();
    for (const n of FILTERS) if (v[n]) q.set(n, v[n]);
    if (key !== "date:desc") q.set("sort", key);
    const qs = q.toString();
    history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
  }

  form.addEventListener("submit", (e) => e.preventDefault());
  form.addEventListener("input", (e) => {
    const t = e.target as HTMLElement;
    if (t === field("sort")) {
      const [col, dir] = field("sort").value.split(":");
      if (col) sort = { col, dir: dir as "asc" | "desc" };
    }
    pages = 1;
    apply();
  });
  form.addEventListener("reset", () => {
    sort = { col: "date", dir: "desc" };
    pages = 1;
    setTimeout(apply); // after the browser has cleared the fields
  });
  document.getElementById("f-empty-clear")!.addEventListener("click", () => form.reset());
  more.addEventListener("click", () => {
    pages++;
    apply();
  });
  document.querySelector(".filter-open")!.addEventListener("click", () => sheet.showModal());
  for (const b of sheet.querySelectorAll("[data-close]")) b.addEventListener("click", () => sheet.close());
  sheet.addEventListener("click", (e) => e.target === sheet && sheet.close()); // backdrop
  // The sheet is a modal only on phones; from 768px its form is inline.
  matchMedia("(min-width: 768px)").addEventListener("change", (e) => e.matches && sheet.open && sheet.close());
  for (const h of heads) {
    h.querySelector("button")?.addEventListener("click", () => {
      const col = h.dataset.col!;
      // Dates and numbers start newest/largest first; names start alphabetically.
      const first = /^(pollster|sponsor)$/.test(col) ? "asc" : "desc";
      sort = { col, dir: sort.col === col ? (sort.dir === "asc" ? "desc" : "asc") : first };
      apply();
    });
  }
  apply();

  // Download the rows currently shown, in the current order, from the full static CSV.
  document.getElementById("csv-filtered")!.addEventListener("click", async () => {
    const text = await (await fetch(u("/data/polls.csv"))).text();
    const [head, ...lines] = text.replace(/^﻿/, "").split("\r\n").filter(Boolean);
    const byKey = new Map(lines.map((l) => [l.slice(0, l.indexOf(",")), l]));
    const keys = rows.filter((r) => !r.hidden).map((r) => r.dataset.key!);
    const body = "﻿" + [head, ...keys.map((k) => byKey.get(k)!)].join("\r\n") + "\r\n";
    const a = Object.assign(document.createElement("a"), {
      href: URL.createObjectURL(new Blob([body], { type: "text/csv;charset=utf-8" })),
      download: "knesset26-polls-filtered.csv",
    });
    a.click();
    URL.revokeObjectURL(a.href);
  });
</script>
