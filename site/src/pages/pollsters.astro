---
import Base from "../layouts/Base.astro";
import Num from "../components/data/Num.astro";
import { BLOC_NAMES, houseEffects, okPolls, pollsterName, polls, sponsorName } from "../lib/data";

const ids = [...new Set(polls.map((p) => p.pollster).filter(Boolean))] as string[];
const avg = (xs: (number | null)[]) => {
  const v = xs.filter((x): x is number => x != null);
  return v.length ? v.reduce((a, b) => a + b, 0) / v.length : null;
};
const effect = (id: string, key: string) =>
  houseEffects.blocs.find((e) => e.pollster === id && e.key === key);
const stats = ids
  .map((id) => {
    const mine = polls.filter((p) => p.pollster === id);
    const he = effect(id, "coalition");
    return {
      id,
      name: pollsterName(id),
      n: mine.length,
      ok: okPolls.filter((p) => p.pollster === id).length,
      sponsors: [...new Set(mine.map((p) => sponsorName(p.sponsor, p.sponsor_raw)))].join(", "),
      respondents: avg(mine.map((p) => p.meta.respondents)),
      rr: avg(mine.map((p) => p.meta.response_rate)),
      he,
    };
  })
  .sort((a, b) => b.n - a.n);
const chartRows = stats
  .filter((s) => s.he)
  .map((s) => ({ name: s.name, effect: s.he!.effect, lo: s.he!.ci_low, hi: s.he!.ci_high, n: s.he!.n_polls }));
---

<Base title="סוקרים" description="השוואת סוקרים: אפקט בית, מזמינים, גודל מדגם ושיעור היענות">
  <h1>סוקרים</h1>
  <p class="lead">
    «אפקט בית» הוא ההפרש הממוצע בין סוקר לבין שאר הסוקרים באותם ימים.
    הוא מראה מי <strong>שונה</strong> מהשאר, לא מי <strong>מוטה</strong>: עד פרסום התוצאות אין דרך לדעת מי קרוב יותר לאמת.
  </p>

  <h2>אפקט בית על {BLOC_NAMES.coalition}</h2>
  <div class="card">
    <div class="chart" id="he-chart" role="img" aria-label={`אפקט בית של כל סוקר על ${BLOC_NAMES.coalition}, עם רווח בטחון של 95%`}></div>
    <div class="axis-captions small muted" dir="ltr">
      <span dir="rtl">פחות מנדטים ל{BLOC_NAMES.coalition} משאר הסוקרים ←</span>
      <span dir="rtl">→ יותר מנדטים ל{BLOC_NAMES.coalition}</span>
    </div>
    <p class="small muted">נקודה = הפרש ממוצע במנדטים; קו = רווח בטחון של 95%. סוקרים עם פחות משני סקרים בממוצע לא מוצגים.</p>
  </div>
  <script type="application/json" id="he-data" set:html={JSON.stringify(chartRows)} />

  <h2>כל הסוקרים</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>סוקר</th><th class="num">סקרים</th><th class="num">בממוצע</th><th>מזמינים</th>
          <th class="num">משיבים (ממוצע)</th><th class="num">היענות (ממוצע)</th>
          <th class="num">אפקט בית, {BLOC_NAMES.coalition}</th>
        </tr>
      </thead>
      <tbody>
        {
          stats.map((s) => (
            <tr>
              <td>{s.name}</td>
              <td class="num">{s.n}</td>
              <td class="num">{s.ok}</td>
              <td style="white-space: normal; min-width: 12rem">{s.sponsors}</td>
              <td class="num">{s.respondents ? Math.round(s.respondents).toLocaleString("he-IL") : "—"}</td>
              <td class="num">{s.rr ? `${s.rr.toFixed(1)}%` : "—"}</td>
              <td class="num">
                {s.he ? (
                  <>
                    <Num kind="signed" value={s.he.effect} /> (<Num kind="signed" value={s.he.ci_low} /> עד{" "}
                    <Num kind="signed" value={s.he.ci_high} />)
                  </>
                ) : (
                  <Num value={null} missing="מעט מדי סקרים בממוצע" />
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="small muted">שיעור היענות מוגדר אחרת אצל כל סוקר, ולכן ההשוואה בו גסה.</p>
</Base>

<script>
  import { houseEffectChart, mount } from "../scripts/charts";
  const rows = JSON.parse(document.getElementById("he-data")!.textContent!);
  mount(document.getElementById("he-chart")!, (w) => houseEffectChart(rows, w));
</script>
