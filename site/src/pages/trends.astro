---
import { u } from "../lib/url";
import Base from "../layouts/Base.astro";
import BlocChart from "../components/charts/BlocChart.astro";
import Num from "../components/data/Num.astro";
import { average, fmtDate, latestParties, parties, pollsterName } from "../lib/data";
import { THRESHOLD_SEATS, sparkPoints, trendsPayload } from "../lib/selectors";

const payload = trendsPayload();
const first = payload.days[0];
const last = payload.days.at(-1)!;
const latest = (id: string) => latestParties.values[id];
const pollsterOpts = Object.entries(payload.pollsterNames).sort((a, b) => a[1].localeCompare(b[1], "he"));
const SPARK_H = 32;
const thresholdY = (SPARK_H - (SPARK_H * THRESHOLD_SEATS) / payload.ymax).toFixed(1);
---

<Base title="מגמות" description="ממוצע הסקרים לפי גוש ולפי מפלגה לאורך זמן, עם כל סקר כנקודה">
  <header class="page-head">
    <h1>מגמות</h1>
    <p class="page-note">
      הקו הוא הממוצע המשוקלל של {average.window_days} הימים האחרונים בכל יום; הרצועה היא הפיזור בין הסוקרים, לא
      טווח לתוצאה; כל נקודה היא סקר.
    </p>
  </header>

  <BlocChart legend="expanded" />

  <section class="trends-parties" aria-labelledby="parties-h">
    <h2 id="parties-h">מפלגות</h2>
    <p class="page-note">
      כל המפלגות על אותו סולם (0–{payload.ymax} מנדטים) ועל אותו ציר זמן. הקו המקווקו הוא אחוז החסימה ({THRESHOLD_SEATS} מנדטים). הקישו על נקודה כדי לראות את הסקר שמאחוריה.
    </p>

    <form class="control-bar" id="trend-controls" aria-label="הגדרות גרפי המפלגות">
      <label>הדגשת סוקר
        <select name="pollster">
          <option value="">ללא הדגשה</option>
          {pollsterOpts.map(([id, name]) => <option value={id}>{name}</option>)}
        </select>
      </label>
      <fieldset class="segmented">
        <legend>טווח זמן</legend>
        <label><input type="radio" name="range" value="full" checked /> מאז {fmtDate(first)}</label>
        <label><input type="radio" name="range" value="30" /> 30 יום</label>
        <label><input type="radio" name="range" value="14" /> 14 יום</label>
      </fieldset>
      <p class="control-msg" id="pollster-msg" aria-live="polite"></p>
    </form>

    {/* Phones: one row per party with a sparkline on the shared scale; a tap opens the full
        chart. From 768px every row is open and the list is a grid of small multiples. */}
    <div class="party-grid">
      {
        payload.charts.map((c) => {
          const v = latest(c.id);
          return (
            <details class="card party-card" id={`party-${c.id}`} data-id={c.id}>
              <summary class="party-card-head">
                <span class="party-cell">
                  <i class="swatch" style={`background: ${parties[c.id]?.color ?? "transparent"}`} />
                  <span class="party-card-name">{c.name}</span>
                </span>
                <svg class="party-spark" viewBox={`0 0 100 ${SPARK_H}`} preserveAspectRatio="none" aria-hidden="true">
                  <line x1="0" x2="100" y1={thresholdY} y2={thresholdY} />
                  {!c.sparse && <polyline points={sparkPoints(c.s, payload.ymax, SPARK_H)} />}
                </svg>
                {v ? (
                  <span class="party-card-num">
                    <Num value={v.mean} />
                    <span class="muted">
                      <span class="sr-only">פיזור בין הסוקרים </span>
                      <Num kind="range" lo={Math.max(0, v.mean - v.sd)} hi={v.mean + v.sd} />
                    </span>
                  </span>
                ) : (
                  <span class="party-card-num muted small">אין ממוצע</span>
                )}
              </summary>
              <div
                class="chart chart-box party-chart"
                data-party={c.id}
                role="img"
                aria-label={`ממוצע המנדטים של ${c.name} לאורך זמן${v ? `; ב-${fmtDate(last)}: ${Math.round(v.mean)}` : ""}`}
              />
              <p class="party-readout" aria-live="polite"></p>
              {c.sparse && <p class="small muted">פחות מ-5 סקרים: מוצגות הנקודות בלבד, בלי קו ממוצע.</p>}
            </details>
          );
        })
      }
    </div>
    <script type="application/json" id="trends-data" set:html={JSON.stringify(payload)} />

    <details class="table-view">
      <summary>הצג את הממוצע העדכני כטבלה</summary>
      <div class="table-wrap" tabindex="0" role="region" aria-label="טבלת הממוצע העדכני לפי מפלגה">
        <table>
          <caption class="sr-only">ממוצע המנדטים לכל מפלגה ב-{fmtDate(last)}, עם הפיזור בין הסוקרים ומספר הסקרים</caption>
          <thead>
            <tr>
              <th scope="col">מפלגה</th>
              <th scope="col" class="num">ממוצע</th>
              <th scope="col" class="num">פיזור בין הסוקרים</th>
              <th scope="col" class="num">סקרים במאגר</th>
            </tr>
          </thead>
          <tbody>
            {
              payload.charts.map((c) => {
                const v = latest(c.id);
                return (
                  <tr>
                    <th scope="row">{c.name}</th>
                    <td class="num"><Num value={v?.mean} digits={1} missing="אין ממוצע" /></td>
                    <td class="num">{v ? <Num kind="range" lo={Math.max(0, v.mean - v.sd)} hi={v.mean + v.sd} digits={1} /> : <Num value={null} missing="אין ממוצע" />}</td>
                    <td class="num">{c.dots.length}</td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </details>
    <p class="downloads">
      <span>הורדה:</span>
      <a href={u("/data/answers.csv")} download="knesset26-answers.csv">כל הסקרים לפי מפלגה (CSV)</a>
      <a href={u("/data/average.json")} download="knesset26-average.json">הממוצע היומי (JSON)</a>
    </p>
  </section>
</Base>

<script>
  import { mount } from "../charts/mount";
  import { u } from "../lib/url";
  import type { PartyData, PartyDot, PartyView } from "../charts/party";
  import { day } from "../charts/theme";

  type Payload = {
    polls: { k: string; d: string; p: string; u: string }[];
    days: string[];
    charts: { id: string; name: string; s: ([number, number] | null)[]; dots: [number, number][]; sparse: boolean }[];
    ymax: number;
    threshold: number;
    pollsterNames: Record<string, string>;
  };
  const payload = JSON.parse(document.getElementById("trends-data")!.textContent!) as Payload;
  const form = document.getElementById("trend-controls") as HTMLFormElement;
  const select = form.elements.namedItem("pollster") as HTMLSelectElement;
  const msg = document.getElementById("pollster-msg")!;
  const DAY = 86_400_000;
  const dateFmt = new Intl.DateTimeFormat("he-IL", { day: "numeric", month: "numeric", year: "numeric", timeZone: "UTC" });

  const polls = payload.polls.map((p) => ({ ...p, x: day(p.d) }));
  const charts: PartyData[] = payload.charts.map((c) => ({
    id: c.id,
    name: c.name,
    sparse: c.sparse,
    series: c.s.flatMap((v, i) => (v ? [{ x: day(payload.days[i]), mean: v[0], sd: v[1] }] : [])),
    dots: c.dots.map(([i, seats]) => ({ x: polls[i].x, seats, pollster: polls[i].p, key: polls[i].k, url: polls[i].u })),
  }));
  const names = new Map(charts.map((c) => [c.id, c.name]));
  const end = day(payload.days.at(-1)!);
  const start = day(payload.days[0]);

  // Restore the highlighted pollster and range from the URL.
  const params = new URLSearchParams(location.search);
  if (params.get("pollster") && payload.pollsterNames[params.get("pollster")!]) select.value = params.get("pollster")!;
  const r = params.get("range");
  if (r === "30" || r === "14") (form.querySelector(`input[name=range][value="${r}"]`) as HTMLInputElement).checked = true;

  function view(): PartyView {
    const range = (form.querySelector("input[name=range]:checked") as HTMLInputElement).value;
    const from = range === "full" ? start : new Date(end.getTime() - (Number(range) - 1) * DAY);
    return { ymax: payload.ymax, threshold: payload.threshold, domain: [from, end], highlight: select.value || null };
  }

  /** The tapped poll, under its own chart: pollster, date, seats, its page and its PDF. */
  function show(party: string, p: PartyDot) {
    const readout = document.querySelector(`#party-${party} .party-readout`)!;
    const who = payload.pollsterNames[p.pollster] ?? p.pollster;
    readout.innerHTML = "";
    const strong = document.createElement("strong");
    strong.textContent = `${p.seats} מנדטים`;
    const page = Object.assign(document.createElement("a"), { href: u(`/polls/${p.key}`), textContent: "לדף הסקר" });
    const pdf = Object.assign(document.createElement("a"), { href: p.url, textContent: "PDF ↗" });
    readout.append(strong, ` · ${who} · ${dateFmt.format(p.x)} · `, page, " · ", pdf);
  }

  function update() {
    const v = view();
    if (v.highlight) {
      const n = polls.filter((p) => p.p === v.highlight && p.x >= v.domain[0] && p.x <= v.domain[1]).length;
      msg.textContent = n
        ? `${payload.pollsterNames[v.highlight]}: ${n} סקרים בטווח, מודגשים בכל הגרפים.`
        : "לסוקר שנבחר אין סקרים בטווח הזמן הזה.";
    } else msg.textContent = "";
    const q = new URLSearchParams(location.search);
    v.highlight ? q.set("pollster", v.highlight) : q.delete("pollster");
    const range = (form.querySelector("input[name=range]:checked") as HTMLInputElement).value;
    range === "full" ? q.delete("range") : q.set("range", range);
    const qs = q.toString();
    history.replaceState(null, "", `${location.pathname}${qs ? `?${qs}` : ""}${location.hash}`);
  }

  // Plot loads once the grid nears the viewport. A chart is drawn when its row is open: on
  // phones when tapped (or named in the URL hash), from 768px always. Drawn charts redraw when
  // the controls change.
  const redraws = new Map<string, () => void>();
  const grid = document.querySelector(".party-grid")!;
  const cards = [...document.querySelectorAll<HTMLDetailsElement>(".party-card")];
  let plot: Promise<typeof import("../charts/party")> | null = null;
  async function draw(card: HTMLDetailsElement) {
    const id = card.dataset.id!;
    if (redraws.has(id) || !card.open) return;
    try {
      const { partyChart } = await (plot ??= import("../charts/party"));
      const c = charts.find((x) => x.id === id)!;
      const el = card.querySelector<HTMLElement>(".party-chart")!;
      redraws.set(id, mount(el, (w, h) => partyChart(c, view(), w, h, (p) => p && show(c.id, p))));
    } catch (err) {
      console.error(err);
      for (const el of document.querySelectorAll<HTMLElement>(".party-chart")) el.hidden = true;
      (document.querySelector(".trends-parties details.table-view") as HTMLDetailsElement).open = true;
    }
  }
  const wide = matchMedia("(min-width: 768px)");
  const openFor = () => {
    const target = location.hash.startsWith("#party-") ? document.querySelector<HTMLDetailsElement>(location.hash) : null;
    for (const card of cards) if (wide.matches || card === target) card.open = true;
  };
  openFor();
  wide.addEventListener("change", openFor);
  addEventListener("hashchange", openFor);
  for (const card of cards) {
    card.addEventListener("toggle", () => started && draw(card));
    // From 768px the rows are a grid of charts that stay open.
    card.querySelector("summary")!.addEventListener("click", (e) => wide.matches && e.preventDefault());
  }
  let started = false;
  new IntersectionObserver((entries, io) => {
    if (entries.some((e) => e.isIntersecting)) {
      io.disconnect();
      started = true;
      cards.forEach(draw);
    }
  }, { rootMargin: "400px 0px" }).observe(grid);

  form.addEventListener("submit", (e) => e.preventDefault());
  form.addEventListener("change", () => {
    update();
    redraws.forEach((r) => r());
  });
  update();
</script>
