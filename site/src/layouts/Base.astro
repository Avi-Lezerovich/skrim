---
// The per-weight files declare every subset with its unicode-range, so the browser fetches
// only Hebrew and Latin (digits live in Latin): ~77KB for three weights. The per-subset files
// (hebrew-400.css…) omit unicode-range and must not be combined.
import "@fontsource/ibm-plex-sans-hebrew/400.css";
import "@fontsource/ibm-plex-sans-hebrew/600.css";
import "@fontsource/ibm-plex-sans-hebrew/700.css";
import hebrew400 from "@fontsource/ibm-plex-sans-hebrew/files/ibm-plex-sans-hebrew-hebrew-400-normal.woff2?url";
import hebrew600 from "@fontsource/ibm-plex-sans-hebrew/files/ibm-plex-sans-hebrew-hebrew-600-normal.woff2?url";
import latin400 from "@fontsource/ibm-plex-sans-hebrew/files/ibm-plex-sans-hebrew-latin-400-normal.woff2?url";
import "../styles/tokens.css";
import "../styles/global.css";
import SiteHeader from "../components/layout/SiteHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import { existsSync, readFileSync } from "node:fs";
import { join } from "node:path";
import { u, unbase } from "../lib/url";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "מאגר פתוח של סקרי הבחירות לכנסת ה-26, מקושר לדיווחים לוועדת הבחירות" } =
  Astro.props;
const path = unbase(Astro.url.pathname).replace(/\/$/, "") || "/";

// Share preview (Open Graph / Twitter). Per-page images come from `npm run og` (public/og/,
// listed in index.json); pages without one, or builds without it, use the committed default.
type OgIndex = { images: Record<string, { file: string; alt: string }> };
const ogIndexFile = join(process.cwd(), "public/og/index.json");
const ogIndex: OgIndex = existsSync(ogIndexFile) ? JSON.parse(readFileSync(ogIndexFile, "utf8")) : { images: {} };
const slug =
  path === "/" ? "home" : path.startsWith("/polls/") ? `poll-${path.slice(7)}` : path.slice(1).replace(/\//g, "-");
const og = ogIndex.images[slug] ?? {
  file: "/og-default.png",
  alt: "הלוגו של skrim והכותרת: מאגר פתוח של סקרי הבחירות לכנסת ה-26",
};
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(u(og.file), site).href;
// og:title carries the page name only; og:site_name carries "skrim".
const ogTitle = title.startsWith("skrim") ? "ממוצע סקרי הבחירות לכנסת ה-26" : title;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title.startsWith("skrim") ? title : `${title} · skrim`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="skrim" />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:type" content={path.startsWith("/polls/") ? "article" : "website"} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content={og.file.endsWith(".jpg") ? "image/jpeg" : "image/png"} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={og.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={og.alt} />
    <link rel="icon" href={u("/favicon.ico")} sizes="48x48" />
    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={u("/apple-touch-icon.png")} />
    <link rel="manifest" href={u("/manifest.webmanifest")} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a19" media="(prefers-color-scheme: dark)" />
    {/* body text, its digits (Latin file) and headings: the faces in the first screen, so the
        swap from the fallback happens before the text above the charts settles (CLS) */}
    {[hebrew400, latin400, hebrew600].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <script is:inline>
      // Apply a saved theme before first paint; the header switch writes it.
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">דלג לתוכן</a>
    <SiteHeader current={path} />
    <main id="main" class="wrap" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
