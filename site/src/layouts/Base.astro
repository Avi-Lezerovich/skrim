---
// The per-weight files declare every subset with its unicode-range, so the browser fetches
// only Hebrew and Latin (digits live in Latin): ~77KB for three weights. The per-subset files
// (hebrew-400.css…) omit unicode-range and must not be combined.
import "@fontsource/ibm-plex-sans-hebrew/400.css";
import "@fontsource/ibm-plex-sans-hebrew/600.css";
import "@fontsource/ibm-plex-sans-hebrew/700.css";
import hebrew400 from "@fontsource/ibm-plex-sans-hebrew/files/ibm-plex-sans-hebrew-hebrew-400-normal.woff2?url";
import "../styles/tokens.css";
import "../styles/global.css";
import DraftBanner from "../components/layout/DraftBanner.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import { EMBARGO_END } from "../lib/data";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "מאגר פתוח של סקרי הבחירות לכנסת ה-26, מקושר לדיווחים לוועדת הבחירות" } =
  Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const draft = new Date() < EMBARGO_END;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title.startsWith("skrim") ? title : `${title} · skrim`}</title>
    <meta name="description" content={description} />
    {draft && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a19" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={hebrew400} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Apply a saved theme before first paint; the header switch writes it.
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">דלג לתוכן</a>
    <DraftBanner />
    <SiteHeader current={path} />
    <main id="main" class="wrap" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
